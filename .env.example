# 복사: cp .env.example .env  후 값 채우기. 실제 .env 는 커밋 금지.
DB_NAME=hopeful_return
DB_USER=sa
# MSSQL SA 암호: 8자+대/소문자/숫자/기호 중 3종 이상. 셸 호환 위해 #, ! 회피(underscore 권장)
DB_PASSWORD=Change_Me_Strong_2026
# 호스트 포트 (네이티브 SQL Server/Redis 와 충돌 시 변경). 컨테이너 내부 포트는 1433/6379 고정
MSSQL_PORT=14330
REDIS_PORT=16379
JWT_SECRET=change-me-to-a-long-random-at-least-32-byte-secret
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-app-password
