# 복사: cp .env.example .env  후 값 채우기. 실제 .env 는 커밋 금지.
DB_NAME=hopeful_return
DB_USER=sa
# MSSQL SA 암호 정책: 8자 이상 + 대문자/소문자/숫자/기호 조합
DB_PASSWORD=ChangeMe#Strong2026!
MSSQL_PORT=1433
REDIS_PORT=6379
# HS256: 최소 32바이트(영문 32자) 이상 랜덤 값
JWT_SECRET=change-me-to-a-long-random-at-least-32-byte-secret
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-app-password
